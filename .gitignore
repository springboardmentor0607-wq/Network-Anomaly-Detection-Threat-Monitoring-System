# ==============================================================================
# NetShield AI - Complete Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Credentials (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env

# ------------------------------------------------------------------------------
# 2. Python & Backend Artefacts
# ------------------------------------------------------------------------------
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
backend/**/__pycache__/

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/env/

# ------------------------------------------------------------------------------
# 3. Database & Local Storage
# ------------------------------------------------------------------------------
# SQLite databases generated locally
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3
netshield.db

# Database migration / dump files
*.sql
*.dump

# ------------------------------------------------------------------------------
# 4. Machine Learning Artefacts & Datasets
# ------------------------------------------------------------------------------
# Serialized joblib/pickle model files (Keep directory structure via README.md/.gitkeep)
backend/saved_models/*.joblib
backend/saved_models/*.pkl
backend/saved_models/*.h5
backend/saved_models/*.onnx
backend/saved_models/*.json
!backend/saved_models/.gitkeep

# NSL-KDD raw datasets (Large files should not be committed to Git)
backend/dataset/*.txt
backend/dataset/*.csv
backend/dataset/*.gz
backend/dataset/*.zip
backend/dataset/*.arff
!backend/dataset/README.md

# Generated exports / reports
*.csv
*.xlsx
*.pdf
backend/exports/
netshield_threat_report.csv

# ------------------------------------------------------------------------------
# 5. Node.js & React Frontend
# ------------------------------------------------------------------------------
# Dependency directory
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production build output
frontend/dist/
frontend/dist-ssr/
frontend/build/

# Vite local cache
frontend/.vite/
.eslintcache

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Operating System Files
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm)
.idea/

# OS-generated metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 7. Testing, Profiling & Logs
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
*.log
backend/logs/