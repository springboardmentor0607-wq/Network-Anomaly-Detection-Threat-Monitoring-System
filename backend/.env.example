# NetShield AI Backend Environment Variables

# App configuration
PROJECT_NAME="NetShield AI Backend"
PORT=8000

# CORS Allowed Origins (Comma-separated string or JSON list)
# Example for production: BACKEND_CORS_ORIGINS="https://your-app.vercel.app,http://localhost:5173"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# MongoDB credentials & connection URL (Local or MongoDB Atlas)
# Example Atlas URL: MONGODB_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="netshield_ai"

# JWT configuration (Ready for authentication)
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY="placeholder_super_secret_key_change_me_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Live Packet Capture Settings
NETSHIELD_CAPTURE_INTERFACE="4"
NETSHIELD_TSHARK_PATH="E:\\Wireshark\\tshark.exe"
