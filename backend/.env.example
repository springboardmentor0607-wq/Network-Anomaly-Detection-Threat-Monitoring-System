# NetShield AI Backend Environment Variables

# App configuration
PROJECT_NAME="NetShield AI Backend"
PORT=8000

# MongoDB credentials & connection URL
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="netshield_ai"

# JWT configuration (Ready for authentication)
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY="placeholder_super_secret_key_change_me_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
