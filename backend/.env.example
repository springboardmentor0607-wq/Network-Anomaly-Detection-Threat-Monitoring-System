# NetShield AI — Enterprise Environment Configuration

# Relational Database (PostgreSQL 16)
DB_ENGINE=postgresql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=netshield_ai

# Document Database (MongoDB 7.0)
MONGO_URI=mongodb://127.0.0.1:27017/netshield_ai
MONGO_DB_NAME=netshield_ai

# Security & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
PORT=5000

# Threat Intelligence Integration (AbuseIPDB / VirusTotal)
THREAT_INTEL_ENABLED=true
THREAT_INTEL_PROVIDER=AbuseIPDB
THREAT_INTEL_API_KEY=your_abuseipdb_api_key
THREAT_INTEL_API_URL=https://api.abuseipdb.com/api/v2/check

# SIEM Webhook Integration (Splunk, QRadar, Elastic, Generic Webhook)
SIEM_ENABLED=false
SIEM_WEBHOOK_URL=http://localhost:8088/services/collector
SIEM_FORMAT=JSON
