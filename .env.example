# NetShield AI System Environment Configuration

APP_NAME="NetShield AI"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Security & Tokens
SECRET_KEY=netshield_super_secret_development_key_change_in_production_32bytes
JWT_SECRET_KEY=netshield_jwt_secret_development_key_change_in_production_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
POSTGRES_USER=netshield
POSTGRES_PASSWORD=netshield_pass
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=netshield_db
DATABASE_URL=postgresql://netshield:netshield_pass@localhost:5432/netshield_db

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Storage & Paths
DATA_STORAGE_PATH=./data
MODEL_STORAGE_PATH=./ml_artifacts
