# NetShield AI Frontend Environment Variables

# The base URL of the FastAPI gateway
# Local Development: http://localhost:8000/api/v1
# Production (Render): https://your-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Optional WebSocket Host override (defaults automatically to VITE_API_URL host or localhost:8000)
# Example: VITE_WS_HOST=your-backend.onrender.com
# VITE_WS_HOST=localhost:8000
